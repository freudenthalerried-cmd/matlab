# Kopieren nach .env und ausfüllen (.env wird nie eingecheckt)
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
PORT=3000
# spar (empfohlen) | genau | guenstig
MODE=spar

# Für den Verkauf: Lizenzpflicht einschalten, Stripe-Schlüssel und Admin-Token setzen
REQUIRE_LICENSE=false
STRIPE_SECRET_KEY=
ADMIN_TOKEN=
DATA_DIR=data
