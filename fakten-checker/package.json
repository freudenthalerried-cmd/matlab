{
  "name": "fakten-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Prüft Behauptungen aus Gesprächen live mit Zahlen aus zuverlässigen Quellen.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "check": "node --check server.js",
    "build:sdk": "echo 'export { default } from \"@anthropic-ai/sdk\";' | esbuild --bundle --format=esm --platform=browser --minify --outfile=public/vendor/anthropic.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
