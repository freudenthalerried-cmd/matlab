# Kopieren nach .env (bzw. im Hosting-Panel als Umgebungsvariablen setzen)
PORT=3000
BRAND=Seitencheck
CONTACT_EMAIL=kontakt@ihre-domain.at
PHONE=+43 ...
# Hinter Caddy/Nginx/Render: 1, damit das Rate-Limit die echte Besucher-IP nutzt
TRUST_PROXY=1
# Optional: Stripe-Zahlungslinks (Dashboard > Payment Links)
STRIPE_LINK_ROAST=
STRIPE_LINK_FIX=
STRIPE_LINK_WARTUNG=
# Optional: neue Anfragen an Make/Zapier/n8n weiterleiten (z. B. E-Mail-Benachrichtigung)
LEAD_WEBHOOK_URL=
# Optional: Google Safe Browsing API-Key (Malware-/Blacklist-Prüfung, kostenlos)
GOOGLE_SAFE_BROWSING_KEY=
SCANS_PER_HOUR=10
# NUR für lokale Tests, niemals in Produktion:
# ALLOW_PRIVATE=1
# ALLOW_ANY_PORT=1
