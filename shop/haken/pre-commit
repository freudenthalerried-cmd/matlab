#!/bin/sh
#
# Bleibt ein Commit stehen, solange der Bestand nicht committierbar ist?
#
# **Der Anlass, 8. September 2026.** Ein Commit dieses Loops rief `git add -A`,
# während im Hintergrund die Gegenproben liefen. Eine davon hielt
# `src/schaufenster.js` absichtlich falsch — der Sollwert der
# Lieferantenbelege um eins verschoben. Die Zeile ging mit und stand
# fünfunddreißig Minuten lang auf dem Zweig: ein Prüfer, der nichts mehr
# misst, veröffentlicht.
#
# Der Satz stand seit dem 4. September im Kopf von `bin/mutationspruefung.mjs`:
# „Wer währenddessen committet, committet die Mutation." Er stand dort als
# Warnung an einen Leser. Gelesen hat ihn niemand, denn committet wird hier
# von einem Programm.
#
#   Eine Regel, die nur als Satz dasteht, gilt für den, der sie liest.
#
# **Und am selben Abend zum zweiten Mal, eine Ebene daneben.** Ein Commit ging
# mit zwei roten Testfällen hinaus, weil `npm test | tail -5` den Ausgang von
# `tail` liefert und nicht den von `npm`. Die Prüfung war gelaufen, das
# Ergebnis war rot, und die Verkettung las eine Null.
#
#   Ein Ausgang, der durch eine Röhre geht, ist der Ausgang der Röhre.
#
# Deshalb stehen beide Prüfungen jetzt im Weg statt in einem Kommentar. Die
# billige zuerst: Wer eine offene Mutation hat, braucht keine Testläufe.
set -e
WURZEL=$(git rev-parse --show-toplevel)

node "$WURZEL/shop/bin/mutationspruefung.mjs" || exit 1

if ! (cd "$WURZEL/shop" && npm test >/dev/null 2>&1); then
  echo 'Abbruch: npm test ist rot — der Commit bleibt stehen.'
  echo 'Ausgabe ansehen mit: npm --prefix shop test'
  exit 1
fi
